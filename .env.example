# SPPUVault Environment Configuration for Cloudflare & Node.js

PORT=3000
NODE_ENV=production

# Database (Official MongoDB native driver over TCP/TLS)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sppuvault?retryWrites=true&w=majority

# Stateless JWT Authentication
JWT_SECRET=your_long_random_jwt_secret_here
ADMIN_USERNAME=Synapse07
ADMIN_PASSWORD=your_secure_admin_password

# Resend HTTPS Email API (Cloudflare Worker native)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=SPPUVault <notifications@sppuvault.com>
EMAIL_USER=admin@sppuvault.com

# Cloudinary PDF & Document Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Assistant Chatbot
GEMINI_API_KEY=your_gemini_api_key

# Payment Gateway (Optional / Marketplace)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
